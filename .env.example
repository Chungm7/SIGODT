# ==============================================================================
# SIGODT - Entorno de Configuración (Ejemplo)
# ==============================================================================

# Entorno: 'local', 'staging', 'production'
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/SIGODT/
SIS_NOM="Sistema de Gestión de Órdenes de Derecho de Trámite"
SIS_VER="2.0.0"

# IP de simulación en desarrollo (utilizada SOLO si APP_ENV !== 'production'
# para peticiones desde localhost o IPv6 hacia sisSeguridad)
DEV_MOCK_IP=192.168.12.44

# ------------------------------------------------------------------------------
# Base de Datos PostgreSQL (db_simcix)
# ------------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=db_simcix
DB_USER=postgres
DB_PASS=tu_contraseña_aqui

# ------------------------------------------------------------------------------
# Servicio Central de Seguridad Institucional (sisSeguridad / SSO Municipal)
# ------------------------------------------------------------------------------
SIS_SEGURIDAD_URL=http://10.10.10.16/sisSeguridad/
SIS_SEGURIDAD_INIT=SIGI

# ------------------------------------------------------------------------------
# Plataforma de Interoperabilidad del Estado Peruano (PIDE / RENIEC / MINSA / SUNAT)
# ------------------------------------------------------------------------------
PIDE_BASE_URL=https://www.munichiclayo.gob.pe/
PIDE_RENIEC_USER=tu_usuario_pide
PIDE_RENIEC_PASS=tu_clave_pide
PIDE_SECRET_KEY=sgd*2023

# ------------------------------------------------------------------------------
# Ente Recaudador Externo (SATCH - Servicio de Administración Tributaria de Chiclayo)
# ------------------------------------------------------------------------------
SATCH_AUTH_URL=http://satch.gob.pe:81/api.test/oauth/token
SATCH_API_URL=http://satch.gob.pe:81/api.test/v1/recibos/getDatosReciboPorOrdenGiro/
SATCH_CLIENT_ID=satchapitest
SATCH_CLIENT_SECRET=tu_client_secret
SATCH_USERNAME=mpch@test.com
SATCH_PASSWORD=tu_password_satch

# ------------------------------------------------------------------------------
# SIGUR Central Authentication & JWT/JWE
# ------------------------------------------------------------------------------
JWT_SECRET=tu_jwt_secret
JWE_SECRET=tu_jwe_secret
SIGUR_URL=http://10.10.10.16/sigur/
BASE_URL=http://10.10.10.16/
DOMAIN=10.10.10.16
APP_NAME=SIGODT
SIST_INIC=SIGI
SIST_PASS=sgd*2025**



# ------------------------------------------------------------------------------
# Doble Factor de Autenticación (2FA) Institucional
# Active sólo tras completar la sensibilización de los usuarios en producción.
# false: login directo al sistema (inicio) y oculta el módulo 2FA en Mi Perfil.
# true: login obligatorio con 2FA (TOTP / Correo) y configuración en Mi Perfil.
# ------------------------------------------------------------------------------
ENABLE_2FA=false

# ------------------------------------------------------------------------------
# Google reCAPTCHA v3 en el login (capa adicional al CAPTCHA de imagen)
# Coloque las claves reales sólo en .env (ignorado por Git). Nunca las versione.
# Con RECAPTCHA_ENABLED=true y una clave ausente el login se rechaza (falla cerrada).
# ------------------------------------------------------------------------------
RECAPTCHA_ENABLED=false
RECAPTCHA_SITE_KEY=tu_site_key_recaptcha
RECAPTCHA_SECRET_KEY=tu_secret_key_recaptcha
RECAPTCHA_MIN_SCORE=0.5
# Opcional: dominio que Google debe reportar (ej. sigodt.ejemplo.gob.pe)
RECAPTCHA_EXPECTED_HOSTNAME=
